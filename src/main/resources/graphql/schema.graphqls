type Query {
  hello: String
  order(id: ID!): Order
  orders: [Order]
  products: [Product]
}

type Order {
  id: ID!
  customerName: String
  email: String
  createdDate: String
  lineItems: [LineItem]
}

type LineItem {
  id: ID!
  qty: Int
  product: Product
}

type Product {
  id: ID!
  name: String
}